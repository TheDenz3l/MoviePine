#!/usr/bin/env bash
# VS Code environment wrapper for Claude Code extension
# Ensures Claude Code gets the right environment variables

cd /Users/bmar/Documents/movieplayer

# Load bridge environment
if [ -f .env.local ]; then
  export $(grep -v '^#' .env.local | grep -E '^(ANTHROPIC_|A4F_)' | xargs)
fi

# Ensure bridge is running
./scripts/claude start >/dev/null 2>&1 || true

# Launch VS Code with environment
exec code "$@"
