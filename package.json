{
  "name": "movieplayer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:turbo": "NEXT_FORCE_TURBOPACK=1 next dev -p 3000",
    "dev:poll": "CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=300 next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:headed": "PW_HEADED=1 playwright test --project=chrome",
    "test:debug": "PWDEBUG=1 playwright test --project=chrome-debug",
    "test:ui": "playwright test --ui",
    "mcp:list": "node scripts/mcp-list.js",
    "mcp:context7:stdio": "npx -y @upstash/context7-mcp",
    "mcp:context7:http": "npx -y @upstash/context7-mcp --transport http --port 3407",
    "mcp:sequential:health": "node scripts/mcp-sequential-health.js",
    "mcp:sequential:test": "node scripts/mcp-sequential-test.js",
    "mcp:sequential:session": "node scripts/mcp-sequential-session.js",
    "mcp:sequential:local": "node scripts/mcp-sequential-local-session.js",
    "mcp:sequential:official": "npx -y @modelcontextprotocol/server-sequential-thinking",
    "mcp:sequential:official:client": "node scripts/mcp-sequential-official-client.js",
    "mcp:sequential:official:sdk": "node scripts/mcp-sequential-official-sdk-client.js"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.45.0",
    "@types/jszip": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.9",
    "jszip": "^3.10.1",
    "lucide-react": "^0.536.0",
    "next": "15.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@modelcontextprotocol/sdk": "^1.17.2",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@upstash/context7-mcp": "^1.0.14",
    "eslint": "^9",
    "eslint-config-next": "15.4.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5"
  }
}
