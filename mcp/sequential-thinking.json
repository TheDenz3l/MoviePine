{
  "name": "sequential-thinking",
  "install": {
    "remote": {
      "url": "https://server.smithery.ai/@smithery-ai/server-sequential-thinking/mcp",
      "transport": "http"
    },
    "local": {
      "command": "npx",
      "args": ["-y", "@smithery-ai/server-sequential-thinking"],
      "note": "If published; otherwise use remote HTTP endpoint above."
    }
  },
  "usage": {
    "invoke": "Ask assistant: 'Sequential plan: <your goal>'",
    "fields": ["thought", "nextThoughtNeeded", "thoughtNumber", "totalThoughts"],
    "tips": [
      "Keep each thought focused.",
      "Revise by marking isRevision if your client supports it.",
      "Stop when nextThoughtNeeded = false and goal satisfied."
    ]
  }
}
