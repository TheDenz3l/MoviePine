# TMDB API Key (Required)
# Get your API key from: https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# Torbox API Key (Optional - for streaming)
# Get your API key from: https://torbox.app/settings
NEXT_PUBLIC_TORBOX_API_KEY=your_torbox_api_key_here

# Torrentio Configuration (Optional)
# Comma-separated list of providers: rarbg,1337x,thepiratebay,kickass,torrentgalaxy,magnetdl,horriblesubs,nyaasi,tokyotosho,anidex
NEXT_PUBLIC_TORRENTIO_PROVIDERS=rarbg,1337x,thepiratebay,kickass

# Debrid Service Configuration (Optional)
# Supported: realdebrid, premiumize, alldebrid
NEXT_PUBLIC_DEBRID_SERVICE=
NEXT_PUBLIC_DEBRID_API_KEY=

# SubDL API Key (Optional - for subtitle downloads)
# Get your API key from: https://subdl.com/api
NEXT_PUBLIC_SUBDL_API_KEY=your_subdl_api_key_here
